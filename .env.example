# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env al repositorio.

# --- Base de datos ---
MYSQL_ROOT_PASSWORD=flash_dev
MYSQL_DATABASE=dbflash
# Conexion usada por el backend (SQLAlchemy)
# Local XAMPP: mysql+pymysql://root@localhost/dbflash
# Docker Compose: mysql+pymysql://root:flash_dev@127.0.0.1:3306/dbflash
DATABASE_URL=mysql+pymysql://root@localhost/dbflash

# --- Seguridad / JWT ---
# Genera una clave nueva con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=genera_una_clave_nueva
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# --- Worker de pagos (backend) ---
INTERNAL_API_TOKEN=dev-internal-token
PAYMENTS_POLL_SECONDS=30

# --- CORS ---
# Origenes permitidos separados por coma (XAMPP / Vite)
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Worker de pagos ---
INTERNAL_API_TOKEN=dev-internal-token
PAYMENTS_POLL_SECONDS=30

# --- QR payment intents ---
QR_INTENT_TTL_SECONDS=300

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
