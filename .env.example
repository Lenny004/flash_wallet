# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env al repositorio.

# --- Base de datos ---
MYSQL_ROOT_PASSWORD=cambia_esto
MYSQL_DATABASE=dbflash
# Conexion usada por el backend (SQLAlchemy)
DATABASE_URL=mysql+pymysql://root@localhost/dbflash

# --- Seguridad / JWT ---
# Genera una clave nueva con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=genera_una_clave_nueva
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# --- CORS ---
# Origenes permitidos separados por coma (XAMPP / Vite)
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
